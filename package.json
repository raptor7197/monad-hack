{
  "name": "monad-hack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "abi": "node scripts/gen-abi.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "set -a && . ./.env && set +a && cd contracts && forge script script/Deploy.s.sol --rpc-url monad --private-key $PRIVATE_KEY --broadcast",
    "seed": "set -a && . ./.env && set +a && cd contracts && forge script script/Seed.s.sol --rpc-url monad --private-key $PRIVATE_KEY --broadcast"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@privy-io/react-auth": "^3.6.1",
    "@privy-io/wagmi": "^4.0.17",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@stripe/crypto": "^1.1.3",
    "@stripe/stripe-js": "^9.16.0",
    "@tanstack/react-query": "^5.103.1",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "viem": "^2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
