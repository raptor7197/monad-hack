# Used by the Foundry scripts. Copy to contracts/.env (git-ignored). No private keys: deploy with a keystore account.

# Seconds a wallet must hold tokens before a proposal snapshot to be eligible.
MIN_HOLDING_PERIOD=60
# Optional: set to a second wallet you control so you can try a blocked vote from MetaMask yourself.
# DEMO_FLAGGED_WALLET=0xYourSecondWallet
# DEMO_RECENT_WALLET=0x...
# Proposal voting window in seconds (default 3 days).
PROPOSAL_DURATION=259200
# Filled after Deploy.s.sol, needed by Seed.s.sol.
# NEXT_PUBLIC_FLIPGUARD_CONTRACT_ADDRESS=0x...
