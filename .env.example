# Copy to .env.local and fill in. Everything here is PUBLIC (shipped to the browser). Never put a private key here.

# --- Monad Testnet ---
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Contracts (printed by `forge script script/Deploy.s.sol`) ---
# Leave empty to run the UI in Demo Preview mode.
NEXT_PUBLIC_FLIPGUARD_CONTRACT_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_TOKEN_ADDRESS=
NEXT_PUBLIC_RISK_REGISTRY_ADDRESS=
# Printed by Seed.s.sol; the three demo proposals are this id, +1, +2.
NEXT_PUBLIC_FIRST_PROPOSAL_ID=1

# --- Demo wallets shown in the risk-assessment panel ---
# Clean = your deployer address. Recent/flagged default to the same derived addresses the scripts use.
NEXT_PUBLIC_DEMO_CLEAN_WALLET=
NEXT_PUBLIC_DEMO_RECENT_WALLET=
NEXT_PUBLIC_DEMO_FLAGGED_WALLET=
NEXT_PUBLIC_DEMO_VOTED_WALLET=

# --- Wallet login ---
# Empty = direct MetaMask connect. Set to your Privy app id (dashboard.privy.io) to enable Privy login
# (MetaMask, email, Google, embedded wallets). Add http://localhost:3000 to the app's allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=
